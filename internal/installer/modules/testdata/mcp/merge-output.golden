{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "angular": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "custom-server": {
      "command": [
        "node",
        "server.js"
      ],
      "enabled": true,
      "type": "local"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "postman": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@postman/mcp-server-local@latest"
      ],
      "enabled": true
    },
    "primeng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "primeng-mcp@latest"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "enabled": true
    }
  },
  "theme": "dark"
}
